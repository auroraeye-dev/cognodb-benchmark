# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# --- CognoDB Cloud (the subject of this benchmark) ---
COGNODB_URI=bolt+s://your-cognodb-host
COGNODB_USER=cognodb
COGNODB_PASSWORD=changeme
COGNODB_DATABASE=            # optional; blank = server default

# --- Neo4j Aura Free (most direct apples-to-apples comparison) ---
# NOTE: username and database are NOT always the stock "neo4j"/"neo4j". Some Aura
# instances authenticate as the instance id and expose the database under that same
# id. Check the credentials file Aura gives you at instance creation and copy both
# verbatim — a wrong username fails auth, a wrong database connects nowhere useful.
NEO4J_AURA_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_AURA_USER=your-instance-id
NEO4J_AURA_PASSWORD=changeme
NEO4J_AURA_DATABASE=your-instance-id    # blank = server default (stock Aura uses "neo4j")

# --- Memgraph (self-hosted via docker-compose, Bolt protocol) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (self-hosted via docker-compose, Cypher over Redis/RESP) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=pokec_bench

# --- NebulaGraph (self-hosted via docker-compose, nGQL) ---
NEBULA_HOST=localhost
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=pokec_bench

# --- Benchmark run configuration ---
BENCH_RANDOM_SEED=42          # fixes dataset sampling AND start-node selection across all DBs
BENCH_READ_ITERATIONS=100     # >= 100 per read workload after warmup, per fairness rules
BENCH_VARIANCE_RUNS=5         # full read suite repeated N times to report spread
BENCH_CONCURRENCY_LEVELS=1,10,40   # concurrency sweep for the mixed workload
